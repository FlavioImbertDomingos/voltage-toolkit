# Copy to .env. Compose reads it automatically.
MOCK_SCENARIO=healthy
MOCK_TLS_CERT_DAYS=20
VOLTAGE_EXPORTER_INTERVAL=15

# Demo credentials (the mock accepts exactly these)
VOLTAGE_SHARED_SECRET=probe-secret
VOLTAGE_PASSWORD=changeme

# Real deployments: whatever your config's secret_env names reference
# VOLTAGE_SHARED_SECRET_PROD=...
